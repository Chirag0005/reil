# ==============================================================================
# Reilly Gray @ Boheme - Environment Configuration
# ==============================================================================
# Copy this file to .env.local (local development) and fill in real values.
# On Vercel, add the same variables under Project → Settings → Environment Variables.
# .env.local is ignored by Git. Never commit real values, and never prefix these
# with NEXT_PUBLIC_ (that would expose them to the browser).

# 1. MongoDB Atlas connection string (Atlas → Connect → Drivers).
#    Appointments are saved to the TerrySalonDB database, appointments collection.
#    URL-encode special characters in the password (e.g. @ → %40).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?retryWrites=true&w=majority

# 2. Resend API key (https://resend.com/api-keys).
RESEND_API_KEY=re_your_api_key_here

# 3. Sender shown on booking notification emails.
#    Testing: "Reilly Gray @ Boheme <onboarding@resend.dev>" (can only deliver to your own Resend account email).
#    Production: an address on a domain verified in Resend, e.g. "Reilly Gray @ Boheme <bookings@your-domain.com>".
RESEND_FROM_EMAIL="Reilly Gray @ Boheme <onboarding@resend.dev>"

# 4. Inbox that receives new appointment request notifications.
BOOKING_NOTIFICATION_EMAIL=you@example.com

# ------------------------------------------------------------------------------
# Admin dashboard (/admin/login): one administrator, no public sign-up.
# Generate the hash and secret with:  node scripts/hash-admin-password.mjs
# (the plain password is never stored; changing it or the secret signs everyone out)
# ------------------------------------------------------------------------------

# 5. Email address the admin signs in with.
ADMIN_EMAIL=you@example.com

# 6. Salted scrypt hash of the admin password (from the script above).
ADMIN_PASSWORD_HASH=scrypt:32768:8:1:<salt>:<hash>

# 7. Random secret (32+ characters) used to sign login sessions (from the script above).
ADMIN_SESSION_SECRET=<long-random-secret>
